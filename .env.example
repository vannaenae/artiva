# Stitch (Google) MCP server connection
# https://stitch.googleapis.com/mcp

# Optional: override the default server URL
STITCH_MCP_URL=https://stitch.googleapis.com/mcp

# Auth — set ONE of the following, depending on how your Stitch access is provisioned:

# An OAuth2 access token, sent as "Authorization: Bearer <token>"
STITCH_ACCESS_TOKEN=

# A Google API key, sent as "x-goog-api-key: <key>"
STITCH_API_KEY=
