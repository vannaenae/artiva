# Firebase project config — from Project Settings > General > Your apps (Web app)
# in the Firebase console. Copy this file to `.env.local` and fill in your values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# When "true" (or when the Firebase config above is left blank), the OTP screen
# accepts any 6-digit code and skips real SMS delivery. Useful for local dev
# and demos without a billed Firebase phone-auth project.
VITE_USE_DEMO_OTP=true
