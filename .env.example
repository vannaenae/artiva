# Copy this file to .env and fill in real values before deploying.
# Vite only exposes vars prefixed with VITE_ to the client bundle — never put
# a secret that must stay server-side in here.

# Paystack — required for real payments. Without this, booking payment shows
# a clear "not configured" error instead of a fake success.
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Firebase — optional. Login/Signup use real Firebase Phone Auth (SMS OTP)
# and sync a Firestore profile doc when these are set (see src/lib/phoneAuth.ts
# and src/lib/firestoreUsers.ts). Without them, sign-in falls back to an
# honest two-step mock flow — same UI, no SMS actually sent, any 4-6 digit
# code confirms.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Push notifications (booking updates, new chat messages) — optional, and
# only usable when Firebase is configured above. This is a separate
# per-project credential from the rest of the Firebase config: generate it
# in the Firebase Console under Project Settings -> Cloud Messaging -> Web
# configuration -> "Generate key pair". Without it, the "Enable" button on
# the Profile page's Notifications card fails with a clear message instead
# of a confusing browser-level error.
VITE_FIREBASE_VAPID_KEY=

# Admin portal passcode (/#/admin/secret-portal). This is a client-bundled
# speed bump, not real authentication — anyone who reads the built JS can
# find it. Set a non-default value so it isn't left at the placeholder.
VITE_ADMIN_PASSCODE=change-me

# NIN (National Identity Number) auto-verification — optional. Must point to
# YOUR OWN backend endpoint (e.g. a Cloud Function) that holds the real NIMC/
# Prembly/YouVerify provider secret and proxies the request — never point
# this at a provider's API directly, since a secret key in client code is a
# public secret key. Without this, admins keep reviewing NIN numbers and ID
# photos by eye in the admin verification queue, same as today.
VITE_NIN_VERIFY_ENDPOINT=
