rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Custom claim set on the admin's Firebase Auth token. Until a backend
    // sets this claim, admin access stays gated client-side by the passcode
    // portal (see AdminLoginPage) — this rule is a second layer, not the
    // only one.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // users/{uid} — one profile doc per signed-in resident or artisan.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    // artisans/{artisanId} — public directory listing; only the artisan
    // themselves (or an admin, e.g. verification review) can write.
    match /artisans/{artisanId} {
      allow read: if true;
      allow create: if isOwner(artisanId);
      allow update: if isOwner(artisanId) || isAdmin();
      allow delete: if false;
    }

    // residents/{residentId} — private to the resident and admins.
    match /residents/{residentId} {
      allow read: if isOwner(residentId) || isAdmin();
      allow create: if isOwner(residentId);
      allow update: if isOwner(residentId) || isAdmin();
      allow delete: if false;
    }

    // bookings/{bookingId} — visible/writable only to the two parties on
    // the booking, plus admins (dispute oversight).
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.residentId == request.auth.uid ||
        resource.data.artisanId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.residentId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.residentId == request.auth.uid ||
        resource.data.artisanId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;
    }

    // disputes/{disputeId} — same access shape as bookings; resolution
    // (outcome) is admin-only in practice but enforced in the UI, since
    // rules alone can't distinguish "counter-statement" from "resolve".
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        resource.data.residentId == request.auth.uid ||
        resource.data.artisanId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.residentId == request.auth.uid ||
        request.resource.data.artisanId == request.auth.uid
      );
      allow update: if isAdmin() || (isSignedIn() && (
        resource.data.residentId == request.auth.uid ||
        resource.data.artisanId == request.auth.uid
      ));
      allow delete: if false;
    }

    // paystackWebhookEvents/{eventId} and payouts/{payoutId} — written only
    // by Cloud Functions using the Admin SDK (functions/src/paystack.ts),
    // which bypasses these rules entirely. Admins can read them for audit
    // purposes; no client, including admins, writes to them directly.
    match /paystackWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /payouts/{payoutId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // otpRateLimits/{phone} — written only by the checkOtpRateLimit Cloud
    // Function (functions/src/otpRateLimit.ts) via the Admin SDK. No client
    // access at all, including admins — a client that could read or write
    // its own counter could reset or inspect it, defeating the limit.
    match /otpRateLimits/{phone} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
