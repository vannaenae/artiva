rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isReasonableUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // verification/{uid}/... — ID docs, selfies, trade certificates,
    // proof of address. Only the owning user can read/write their own
    // verification files.
    match /verification/{uid}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid && isReasonableUpload();
    }

    // disputes/{disputeId}/... — evidence photos. Any signed-in user can
    // read (both parties + admin need to see evidence); writes still get
    // basic size/type validation. Fine-grained "only the two parties on
    // this dispute" checks would need the dispute doc looked up from
    // Storage rules, which isn't supported — enforced in the UI instead.
    match /disputes/{disputeId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isReasonableUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
